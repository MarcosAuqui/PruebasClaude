{
  "name": "traductor-de-pantalla",
  "version": "1.0.0",
  "description": "Traducción en tiempo real del texto dentro de un recuadro transparente en pantalla",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.traductor.pantalla",
    "productName": "Traductor de Pantalla",
    "files": ["src/**/*", "package.json"],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  }
}
